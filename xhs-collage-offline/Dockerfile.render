FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk wget && rm -rf /var/lib/apt/lists/*
COPY render-server.mjs ./
ENV XHS_DATA_DIR=/data XHS_RENDER_PORT=8767
EXPOSE 8767
CMD ["node", "render-server.mjs"]
